<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (required for notarization) blocks Apple Events unless asked for.
	     Foray sends one kind: asking Finder to store Get Info comments (DESIGN.md §5.8). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
